{
  "name": "remix-saas",
  "description": "A Lightweight, Feature-Rich, and Production-Ready Remix Stack for your next SaaS application.",
  "author": "Daniel Kanem <devxo@mail.com> (https://twitter.com/DanielKanem)",
  "repository": "dev-xo/remix-saas",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "build": "remix vite:build",
    "dev": "node --env-file=.env ./server.mjs",
    "start": "cross-env NODE_ENV=production node --env-file-if-exists=.env ./server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "stripe:listen": "stripe listen --forward-to localhost:3000/api/webhook",
    "setup": "node remix.init/index.js --env-only && prisma generate && prisma db push && prisma db seed",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:smoke": "cross-env RUN_APP_SMOKE=true vitest run tests/integration/smoke.test.js"
  },
  "dependencies": {
    "@conform-to/react": "1.21.3",
    "@conform-to/zod": "1.21.3",
    "@epic-web/client-hints": "1.3.9",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "@remix-run/express": "2.17.5",
    "@remix-run/node": "2.17.5",
    "@remix-run/react": "2.17.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "compression": "1.8.2",
    "cookie": "2.0.1",
    "cross-env": "10.1.0",
    "crypto-js": "4.2.0",
    "express": "4.22.3",
    "express-rate-limit": "8.7.3",
    "helmet": "8.3.0",
    "i18next": "23.16.8",
    "i18next-browser-languagedetector": "8.3.0",
    "intl-parse-accept-language": "1.0.0",
    "isbot": "5.2.2",
    "lucide-react": "1.66.0",
    "morgan": "1.12.1",
    "prisma": "7.10.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "^15.7.4",
    "remix-auth": "4.2.0",
    "remix-auth-github": "3.0.2",
    "remix-auth-totp": "4.0.0",
    "remix-i18next": "6.4.1",
    "remix-utils": "7.7.0",
    "sonner": "2.0.8",
    "stripe": "23.1.0",
    "tailwind-merge": "2.6.1",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@remix-run/dev": "2.17.5",
    "@types/compression": "1.8.1",
    "@types/express": "4.17.25",
    "@types/morgan": "1.9.10",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "remix-flat-routes": "0.8.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "vite": "6.4.5",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.16.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@remix-run/router": "1.23.4",
    "remix-utils": {
      "zod": "$zod"
    },
    "@react-email/components": {
      "@react-email/render": "$@react-email/render"
    },
    "tar": "^7.5.22",
    "estree-util-value-to-estree": "^3.5.0",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6"
  }
}
