# Local development: no external accounts or credentials required.
NODE_ENV="development"
MOCK_SERVICES="true"
SESSION_SECRET="GENERATE_WITH_NPM_RUN_SETUP"
ENCRYPTION_SECRET="GENERATE_WITH_NPM_RUN_SETUP"
HONEYPOT_ENCRYPTION_SEED="GENERATE_WITH_NPM_RUN_SETUP"
DEV_HOST_URL="http://localhost:3000"
PROD_HOST_URL=""
DATABASE_URL="file:./data.db?connection_limit=1"

# Optional real integrations: set MOCK_SERVICES=false and fill these in.
# Mock email prints codes and magic links in the server terminal.
RESEND_API_KEY=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_ENDPOINT=""
